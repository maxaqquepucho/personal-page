---
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'
import { socialLinks } from '@/data/social'
---

<section class="flex gap-3 mt-6">
  {
    socialLinks.map(item => (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class={cn(
          buttonVariants({ variant: 'outline', size: 'sm' }),
          'rounded-full bg-gray-800 border-gray-600 text-gray-200 hover:bg-gray-100 hover:text-black',
          item.hideName && '!px-2'
        )}
      >
        <item.icon size={16} weight="regular" />
        {!item.hideName && <span class="ml-2">{item.name}</span>}
      </a>
    ))
  }
</section>
