---
import type { ExperienceEntry } from '@/data/experience'

interface Props {
  item: ExperienceEntry
}

const { item } = Astro.props
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4"
>
  <div class="relative pb-12 col-span-2">
    <div class="sticky top-0">
      <span
        class="text-blue-400 -left-[42px] absolute rounded-full text-5xl"
      >
        &bull;
      </span>
      <h3 class="text-xl font-bold text-blue-400">{item.title}</h3>
      <h4 class="font-semibold text-xl text-white">{item.company}</h4>
      <time class="p-0 m-0 text-sm text-white/80">{item.date}</time>
    </div>
  </div>
  <div
    class="relative flex flex-col gap-2 pb-4 text-gray-300 md:col-span-3"
  >
    {item.description}
  </div>
</div>
